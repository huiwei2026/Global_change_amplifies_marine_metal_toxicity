############## Stressor ####################
data<-read.csv ("Supplementary Data 1.csv", header =T)
nrow(data)
data <- subset(data, Research.setting == "Field")
nrow(data)
data$Stressor<-factor(data$Stressor)
rep_data <- as.data.frame(table(data$Stressor))
colnames(rep_data) <- c("Stressor","rep")
data <- merge(data, rep_data, by = c("Stressor"))
data$Stressor<-factor(data$Stressor)
rmod.mix <- rma.mv(yi, vi,
mods = ~ Stressor- 1,
method = "REML",
subset = rep >= 3,
random=list (~1| Paper_id/Observation_id),
data = data)
rmod.mix
summary(glht(rmod.mix,
linfct=cbind(contrMat(c("A"=1,"H"=1,"W"=1),
type="Tukey"))), test=adjusted("none"))
summary(glht(rmod.mix,
linfct=cbind(contrMat(c("A"=1,"H"=1,"W"=1),
type="Tukey"))), test=adjusted("none"))
